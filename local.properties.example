# Copy to local.properties and fill in your values.
# local.properties is gitignored and must not be committed.

sdk.dir=/path/to/Android/Sdk

# Telegram API credentials from https://my.telegram.org
TELEGRAM_API_ID=your_api_id
TELEGRAM_API_HASH=your_api_hash

# Release signing (place microgram.jks at the path below; the file is gitignored)
RELEASE_KEYSTORE_PATH=TMessagesProj/config/microgram.jks
RELEASE_STORE_PASSWORD=your_store_password
RELEASE_KEY_ALIAS=your_key_alias
RELEASE_KEY_PASSWORD=your_key_password
